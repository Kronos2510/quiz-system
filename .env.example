# ---------------------------------------------------------------------------
# Quiz System — environment variables
# Copy to .env for local development. On Vercel, set these in Project Settings.
# ---------------------------------------------------------------------------

APP_NAME=Quiz System
APP_TAGLINE=Host it. Take it. Grade it.

# Local development can use SQLite with zero setup:
DATABASE_URL=sqlite:///./dev.db
# Production (Supabase transaction pooler, port 6543). Keep the
# postgresql+psycopg:// driver prefix so SQLAlchemy uses psycopg 3.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Direct/session connection (port 5432) used only by scripts/init_db.py.
# DIRECT_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-deploying

# Seeded platform admin (created on first start if missing)
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@quizsystem.local
ADMIN_PASSWORD=Admin1234!

# Set to 1 in production so session cookies are HTTPS-only.
COOKIE_SECURE=0

# Session lifetime in seconds (default: 14 days).
SESSION_MAX_AGE=1209600

# Seed the demo host, participants and two quizzes on an empty database.
SEED_DEMO=1
